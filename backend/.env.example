# ============================================================
# ULTRABULB IT — Environment Configuration Template
# ============================================================

# Server Environment
NODE_ENV=production
PORT=4000

# Security (Generate a random 32+ character string for production)
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars

# Allowed Frontend Origins (comma-separated for multiple domains)
CLIENT_ORIGIN=https://ultrabulbit.com,https://www.ultrabulbit.com,http://localhost:5173

# Database Connection (MongoDB Atlas or self-hosted MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ultrabulb?retryWrites=true&w=majority

# Local File Upload Directory (if not using Cloudinary)
UPLOAD_DIR=uploads

# Cloudinary Storage (Optional — for cloud image hosting)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ============================================================
# Hostinger Email / SMTP Configuration (for contact@ultrabulbit.com)
# ============================================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@ultrabulbit.com
SMTP_PASS=your-hostinger-email-password
NOTIFICATION_EMAIL=contact@ultrabulbit.com
MAIL_FROM="ULTRABULB IT" <contact@ultrabulbit.com>
