// ULTRABULB IT — Full dynamic website schema
// Every piece of website content is editable from the admin dashboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Admin authentication ----
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---- Generic key/value site content (hero, about, vision, contact info, footer, stats...) ----
// The admin can edit every one of these. Single source of truth for editable text.
model SiteContent {
  id    String @id
  value String
}

// ---- Products / previous projects showcase ----
model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String
  galleryUrls String?
  category    String
  categoryId  String?
  serviceCategory ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  techStack   String?
  review      String?
  awards      String?
  accessFeatures String?
  serviceOwners String?
  link        String?
  tags        String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  order       Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---- Career vacancies with hiring / no-hiring status ----
model Vacancy {
  id           String   @id @default(cuid())
  title        String
  department   String
  type         String // Full-time / Part-time / Contract / Internship
  location     String
  description  String
  requirements String
  hiring       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Gallery photos of the journey ----
model GalleryImage {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  category  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ---- Reviews (pending approval) ----
model Review {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String
  company   String
  rating    Int
  message   String
  avatarUrl String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---- Awards with pictures ----
model Award {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String
  issuer      String
  year        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// ---- Scheduled calls (from the /schedule page) ----
model ScheduledCall {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  topic     String
  date      String // ISO date (YYYY-MM-DD)
  timeSlot  String
  message   String?
  status    String   @default("pending") // pending | confirmed | cancelled | completed
  createdAt DateTime @default(now())
}

// ---- Contact form messages ----
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---- Available time slots for scheduling (editable from admin) ----
model TimeSlot {
  id     String  @id @default(cuid())
  label  String
  value  String
  active Boolean @default(true)
  order  Int     @default(0)
}
